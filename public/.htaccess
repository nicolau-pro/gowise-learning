###############################################
# 🌐 Canonical Domain: Force HTTPS + Non-WWW
###############################################
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://gowiselearning.co.uk/$1 [L,R=301]

# Force Non-WWW
RewriteCond %{HTTP_HOST} ^www\.gowiselearning\.co\.uk$ [NC]
RewriteRule ^(.*)$ https://gowiselearning.co.uk/$1 [L,R=301]


###############################################
# 📌 Force Trailing Slash for Directories
###############################################
# Only apply if:
# - Not a real file
# - Not a real folder
# - Not a static asset (png, js, pdf etc)
# - URL does not already end with a slash

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$    # ignore file extensions
RewriteCond %{REQUEST_URI} !/$                     # ignore already-slashed URLs
RewriteRule ^(.*)$ https://gowiselearning.co.uk/$1/ [L,R=301]


###############################################
# 📄 Custom 404 Page (PreSite static version)
###############################################
ErrorDocument 404 /404.html


###############################################
# 📌 SPA Routing Fallback — serve 404.html
#     (only if file/folder does not exist)
###############################################
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule .* /404.html [L]


###############################################
# 📦 Browser Caching for Static Assets
###############################################
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images — 1 year
  ExpiresByType image/webp     "access plus 1 year"
  ExpiresByType image/jpeg     "access plus 1 year"
  ExpiresByType image/png      "access plus 1 year"
  ExpiresByType image/gif      "access plus 1 year"
  ExpiresByType image/svg+xml  "access plus 1 year"
  ExpiresByType image/x-icon   "access plus 1 year"

  # Fonts — 1 year
  ExpiresByType font/woff      "access plus 1 year"
  ExpiresByType font/woff2     "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # CSS & JS — 1 year (safe because Vite version-hashes filenames)
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript        "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Strong static caching
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|gif|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML files — never cached
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>


###############################################
# 🛑 Disable directory listing
###############################################
Options -Indexes
