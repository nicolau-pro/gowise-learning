# -------------------------
# ✅ Force Trailing Slash for Directories (Canonical URLs)
# -------------------------
RewriteEngine On

# Do NOT redirect if the request is a real file
RewriteCond %{REQUEST_FILENAME} !-f

# Do NOT redirect if URL ends with a known file extension (pdf, images, css, js, etc)
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$

# Do NOT redirect if it already has a trailing slash
RewriteCond %{REQUEST_URI} !/$

# Redirect to URL with trailing slash
RewriteRule ^(.*)$ https://gowiselearning.co.uk/$1/ [L,R=301]

# -------------------------
# ✅ Browser Caching for Static Assets
# -------------------------

# Enable mod_expires
<IfModule mod_expires.c>
  ExpiresActive On

  # Default: 1 month cache
  ExpiresDefault "access plus 1 month"

  # Images (WebP, JPEG, PNG, SVG, etc): 1 year
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts: 1 year
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # CSS and JS: 1 year (since your filenames are versioned)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

# Add strong Cache-Control headers
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|gif|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML files cache only briefly (to see updates quickly)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
